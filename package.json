{
  "name": "photomatcher",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @photomatcher/web dev",
    "dev:web": "pnpm --filter @photomatcher/web dev",
    "dev:mobile": "pnpm --filter @photomatcher/mobile start",
    "dev:flutter": "cd apps/flutter && flutter run",
    "build:aab": "pnpm --filter @photomatcher/mobile build:aab",
    "build:apk:local": "pnpm --filter @photomatcher/mobile build:apk:local",
    "build": "pnpm -r --filter=./packages/* build && pnpm --filter @photomatcher/web build",
    "test": "pnpm --filter @photomatcher/color-engine test",
    "lint": "pnpm -r lint --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
