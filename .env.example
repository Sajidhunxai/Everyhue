# Web (apps/web/.env.local)
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=generate-a-long-random-string
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: same Android OAuth client ID as mobile — validates Google id_tokens from the app
AUTH_GOOGLE_ANDROID_ID=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Supabase Postgres (see SUPABASE.md)
# Pooled URL for the app (port 6543, pgbouncer) — use on Vercel
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct URL for prisma db push / migrate (port 5432)
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Optional Supabase JS client (app DB access is still Prisma + DATABASE_URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

OPENAI_API_KEY=
# Server-only: powers AI stylist on web AND mobile (mobile calls /api/stylist).
# Never put this in apps/mobile/.env — keep it on the web server only.

# Mobile (apps/mobile/.env)
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:3000
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
