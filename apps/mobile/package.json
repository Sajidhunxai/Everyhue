{
  "name": "@photomatcher/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "tsc --noEmit",
    "build:apk": "eas build --profile apk --platform android",
    "build:aab": "eas build --profile production --platform android",
    "submit:android": "eas submit --platform android --profile production",
    "build:apk:local": "powershell -ExecutionPolicy Bypass -File ./scripts/build-apk-local.ps1",
    "print:sha1": "powershell -ExecutionPolicy Bypass -File ./scripts/print-sha1.ps1",
    "build:dev": "eas build --profile development --platform android"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@photomatcher/api-client": "workspace:*",
    "@photomatcher/color-engine": "workspace:*",
    "@photomatcher/types": "workspace:*",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@shopify/react-native-skia": "2.2.12",
    "babel-preset-expo": "~54.0.10",
    "buffer": "^6.0.3",
    "expo": "~54.0.37",
    "expo-auth-session": "~7.0.11",
    "expo-build-properties": "^57.0.21",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
